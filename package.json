{
  "name": "an-cloudflare-1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --keep-vars",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "generate-migrations": "drizzle-kit generate",
    "migrate-remote": "wrangler d1 migrations apply anoosha-store --remote",
    "migrations-list-remote": "wrangler d1 migrations list anoosha-store --remote",
    "verify-migrations-remote": "wrangler d1 execute anoosha-store --remote --command=\"SELECT * FROM todos;\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@opennextjs/cloudflare": "^1.20.3",
    "@reduxjs/toolkit": "^2.14.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "jspdf": "^4.2.1",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-toastify": "^11.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.158.0"
  }
}
